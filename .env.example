# Parrot MCP server configuration
# Copy to .env (docker-compose picks it up) or export in your shell / client config.

# ---------------------------------------------------------------- server ----
# stdio (client launches the server) | http (long-running, clients connect over network)
PARROT_MCP_TRANSPORT=http
PARROT_MCP_HOST=0.0.0.0
PARROT_MCP_PORT=8420
PARROT_MCP_PATH=/mcp
# Required for HTTP transport: clients send "Authorization: Bearer <token>"
PARROT_MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# ------------------------------------------------------------- execution ----
# local = run on this machine | ssh = run on a remote Parrot VM | docker = run in a container
PARROT_MCP_TARGET=local
# default per-command timeout (seconds) and output clipping (chars)
PARROT_MCP_TIMEOUT=900
PARROT_MCP_MAX_OUTPUT=30000
# 1 = run every command with zero checks (full-control mode, no destructiveness confirmation)
PARROT_MCP_DISABLE_GUARDRAILS=0

# ------------------------------------------------------------- ssh target ----
PARROT_MCP_SSH_HOST=192.168.56.101
PARROT_MCP_SSH_PORT=22
PARROT_MCP_SSH_USER=root
# Authenticate with EITHER a password OR a private key (key wins if both set):
PARROT_MCP_SSH_PASSWORD=
PARROT_MCP_SSH_KEY_PATH=/home/you/.ssh/id_ed25519
PARROT_MCP_SSH_KEY_PASSPHRASE=
# Or paste the key content directly (handy for Docker deployments):
PARROT_MCP_SSH_KEY_DATA=
# 1 = refuse unknown host keys (production), 0 = auto-add new host keys (VMs/labs)
PARROT_MCP_SSH_STRICT_HOST_KEY=0

# ---------------------------------------------------------- docker target ----
# Official Parrot images: parrotsec/security (pentest tools preloaded) | parrotsec/core (minimal)
PARROT_MCP_DOCKER_IMAGE=parrotsec/security:latest
# Named container: created on first use and reused, so files, msf sessions and
# loot survive between commands. Point at a NEW name to start fresh, or set
# this to an empty value for a throwaway container per command.
PARROT_MCP_DOCKER_CONTAINER=parrot-mcp

# ------------------------------------------------------------- audit ----
# Optional: append one JSON line per command (timestamp, target, command,
# exit code, duration) to this file. Output is not recorded.
PARROT_MCP_AUDIT_LOG=

# ------------------------------------------------------------------ misc ----
PARROT_MCP_LOG_LEVEL=WARNING
